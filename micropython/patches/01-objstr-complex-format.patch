+#if MICROPY_PY_BUILTINS_COMPLEX
+// FEMM patch: format a complex under a numeric type code, which MicroPython
+// otherwise refuses -- "%g" % z and "{:g}".format(z) both raise upstream.
+//
+// The output is CPython's, exactly: both components always, signed imaginary
+// part, a trailing j, and no parentheses, so format(3+4j, 'g') is "3+4j",
+// format(1j, 'g') is "0+1j" and format(3+0j, 'g') is "3+0j". Nothing is
+// collapsed -- that only happens for str()/repr(), which MicroPython already
+// renders as CPython does.
+//
+// The I*-notation this used to print belongs to the TCP wire format alone
+// (libfemm/py_state.cpp), which is an interface contract with the octave/
+// matlab/mathematica clients. It has no business in a script's own output.
+//
+// The text is built into a vstr first and then padded as a unit, so width and
+// alignment mean for a complex what they mean for a real -- "{:>14g}" pads to
+// fourteen columns whether the value has an imaginary part or not.
+static void femm_print_complex(const mp_print_t *print, mp_obj_t arg, char type,
+                               int flags, char fill, int width, int prec) {
+    vstr_t vstr;
+    mp_print_t vstr_print;
+    vstr_init_print(&vstr, 24, &vstr_print);
+
+    mp_float_t re, im;
+    mp_obj_complex_get(arg, &re, &im);
+
+    mp_print_float(&vstr_print, re, type, 0, 0, 0, prec);
+    // Negative zero counts as negative, as it does in CPython: 3-0.0j prints
+    // "3-0j". Comparing 1/im catches it without needing signbit().
+    bool neg = (im < 0) || (im == 0 && (mp_float_t)1 / im < 0);
+    mp_print_str(&vstr_print, neg ? "-" : "+");
+    mp_print_float(&vstr_print, neg ? -im : im, type, 0, 0, 0, prec);
+    mp_print_str(&vstr_print, "j");
+
+    mp_print_strn(print, vstr.buf, vstr.len, flags, fill, width);
+    vstr_clear(&vstr);
+}
+#endif
+
