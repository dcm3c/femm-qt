+#if MICROPY_PY_TIME_HOST_TIMEZONE
+// FEMM: a real gmtime, rather than an alias for localtime. Both forms are UTC;
+// the no-argument one only needs a "now" in epoch seconds to convert.
+static mp_obj_t time_gmtime(size_t n_args, const mp_obj_t *args) {
+    timeutils_struct_time_t tm;
+    mp_timestamp_t seconds = (n_args == 0 || args[0] == mp_const_none)
+        ? mp_time_now_seconds()
+        : timeutils_obj_get_timestamp(args[0]);
+    timeutils_seconds_since_epoch_to_struct_time(seconds, &tm);
+    return time_struct_time_tuple(&tm);
