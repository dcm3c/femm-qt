# Solver solution outputs — regenerated by the test on every run
*.ans
*.res
*.anh

# Scratch models written by mi_saveas during the test run
temp.*
bias.*
incr.*
rtemp.*
rbias.*
rincr.*

# femm-qt run output, regenerated on every run and fed to the comparators.
# (OF_result.txt / OF_elec_result.txt, the Original-FEMM golden references, ARE
# checked in.)
fq_result.txt
fq_elec_result.txt
fq_heat_result.txt
fq_curr_result.txt
fq_line_result.txt
fq_eline_result.txt
fq_iline_result.txt
fq_hline_result.txt
fq_gap_result.txt
fq_circ_result.txt
fq_eic_result.txt
fq_hic_result.txt
fq_cic_result.txt
fq_pv_result.txt
fq_bh_result.txt
fq_eopv_result.txt
fq_hopv_result.txt
fq_copv_result.txt

# The committed femm-qt self-consistency reference IS tracked (the bare
# fq_*.txt patterns above would otherwise ignore it at any depth).
!fq_reference/
!fq_reference/*
