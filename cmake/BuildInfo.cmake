# Stamp the build identity -- version and build number -- into the generated
# files that carry it.
#
#   cmake -DIN=<template> -DOUT=<generated build_info.cpp> -DGEN_DIR=<dir>
#         -DSRC_DIR=<femm-qt source> -DGIT=<git executable or empty>
#         -DFEMM_VERSION=5.0.20261013 -P BuildInfo.cmake
#
# Run at configure time so the files exist for a first build, and again as a
# custom target on EVERY build, so the build number follows each new commit
# without a re-configure. Every file is rewritten only when its content
# differs, so the recompile-and-relink this triggers happens when the commit
# changes, not on every build.
#
# THE BUILD NUMBER is the commit count of the source, `git rev-list --count
# HEAD`: one number that goes up with every commit, so it sorts, unlike a hash.
# It is taken, in this order, from
#   1. a BUILD_NUMBER file at the source root. packaging/buildsource.bat writes
#      one into the source zip (git archive leaves out .git), so a build from
#      the zip -- the Mac's -- gets the same number as a build from the
#      checkout it was cut from. It is never in the repository (.gitignore).
#      Checked FIRST so a zip unpacked inside some unrelated git repository
#      does not take that repository's count.
#   2. git, in a checkout. "-dirty" is appended when tracked files under the
#      source have uncommitted changes, so such a build is never mistaken for
#      the clean build of the same commit.
#   3. "0", e.g. a GitHub source tarball, which has neither.

set(build "")
if(EXISTS "${SRC_DIR}/BUILD_NUMBER")
    file(STRINGS "${SRC_DIR}/BUILD_NUMBER" build LIMIT_COUNT 1)
    string(STRIP "${build}" build)
elseif(GIT)
    execute_process(COMMAND "${GIT}" rev-list --count HEAD
                    WORKING_DIRECTORY "${SRC_DIR}"
                    OUTPUT_VARIABLE build OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE rc ERROR_QUIET)
    if(NOT rc EQUAL 0)
        set(build "")
    else()
        execute_process(COMMAND "${GIT}" diff --quiet HEAD -- .
                        WORKING_DIRECTORY "${SRC_DIR}"
                        RESULT_VARIABLE dirty ERROR_QUIET)
        if(dirty EQUAL 1)
            string(APPEND build "-dirty")
        endif()
    endif()
endif()
if(NOT build MATCHES "^[0-9]+(-dirty)?$")
    set(build "0")
endif()
set(FEMM_BUILD "${build}")

# Rewrite <out> from <content> only if it changed.
function(write_if_changed out content)
    file(WRITE "${out}.tmp" "${content}")
    configure_file("${out}.tmp" "${out}" COPYONLY)
    file(REMOVE "${out}.tmp")
endfunction()

configure_file("${IN}" "${OUT}" @ONLY)

# The Windows installer (packaging/femm-qt.iss #includes this).
write_if_changed("${GEN_DIR}/version.iss"
    "; GENERATED by cmake/BuildInfo.cmake -- do not edit.\n#define FemmVersion \"${FEMM_VERSION}\"\n#define FemmBuild \"${FEMM_BUILD}\"\n")

# The macOS image (packaging/macos_dmg.sh sources this).
write_if_changed("${GEN_DIR}/version.env"
    "# GENERATED by cmake/BuildInfo.cmake -- do not edit.\nFEMM_VERSION=${FEMM_VERSION}\nFEMM_BUILD=${FEMM_BUILD}\n")
