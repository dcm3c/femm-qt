    RowBox[{"GetPackageDirectory", "[", "]"}], ",", 
    "\"\<examples\\\\temp.fem\>\""}], "]"}], "]"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"M", "=", 
   RowBox[{"{", "}"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "0"}], ",", 
   RowBox[{"i", "\[LessEqual]", "10"}], ",", 
   RowBox[{"i", "++"}], ",", 
   RowBox[{
    RowBox[{"MIAnalyze", "[", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"MILoadSolution", "[", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"M", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"M", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "*", "0.001"}], ",", 
         RowBox[{
          RowBox[{"MOGetCircuitProperties", "[", "\"\<secondary\>\"", "]"}], 
          "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"MISelectGroup", "[", "1", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"MIMoveTranslate", "[", 
     RowBox[{"0", ",", "0.1"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"MIClearSelected", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dataplot", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{"M", ",", 
    RowBox[{"Joined", "\[Rule]", "True"}]}], "]"}]}]], "Input"],

