  RowBox[{"ToFileName", "[", " ", 
   RowBox[{
    RowBox[{"GetPackageDirectory", "[", "]"}], ",", 
    "\"\<examples\\\\beltcoil.fem\>\""}], "]"}], "]"}]], "Input"],

