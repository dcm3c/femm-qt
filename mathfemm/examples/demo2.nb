Cell["Demonstration of MathFEMM Functionality", "Section"],

Cell[TextData[{
  "David Meeker\nSenior Engineer\nFoster-Miller, Inc.\n350 Second Avenue\n\
Waltham, MA 02451-1196\n781-684-4070\n781-890-3489 (fax)\n",
