Cell["\<\
If we were interested in the flux density at specific positions, we could \
inquire at specific points directly:\
\>", "Text",ExpressionUUID->"5cbf41ba-3d7e-4060-ab89-25a83c38a630"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MOGetB", "[", 
  RowBox[{"0", ",", "0"}], "]"}]], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"9057377b-faf3-4bf3-aa1b-fbe964a896b9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0.5044318597001273`"}], "}"}]], "Output",
 CellChangeTimes->{3.6566278208749623`*^9, 3.6566278908473845`*^9, 
