}, Open  ]],

Cell["\<\
If we were interested in inductance, it could be obtained by dividing flux \
linkage by current\
\>", "Text",ExpressionUUID->"0a0ed4ca-de65-4d15-9ffd-3e1953fbcb00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"L", "=", 
