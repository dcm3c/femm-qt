Cell["\<\
The program will report the terminal properties of the circuit:  current, \
voltage, and flux linkage \
\>", "Text",ExpressionUUID->"67ff04fa-e961-4538-95fa-04a739aa3424"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"i", ",", "v", ",", "\[Phi]"}], "}"}], "=", 
  RowBox[{"MOGetCircuitProperties", "[", "\"\<icoil\>\"", "]"}]}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"d14dcf9f-4756-4755-ae3f-0298aaa526d9"],

