Cell["\<\
We have to give the geometry a name before we can analyze it.  We will save \
it in the examples subdirectory of MathFEMM.\
\>", "Text",ExpressionUUID->"5747acbe-b9cf-4b8e-a694-29bc19e7bea2"],

Cell[BoxData[
 RowBox[{"MISaveAs", "[", 
  RowBox[{
   RowBox[{"NotebookDirectory", "[", "]"}], "<>", "\"\<coil.fem\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.6566277815476227`*^9, 3.65662779540751*^9}, 
   3.656627841133731*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"830af34c-71ff-4d9f-b4c4-4ff199f2adc0"],

Cell["\<\
Now,analyze the problem and load the solution when the analysis is finished\
\>", "Text",ExpressionUUID->"0991a682-36e4-4be7-a3b1-9d30316f9a29"],

Cell[BoxData[
 RowBox[{"MIAnalyze", "[", "]"}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"222fd221-ed0f-474c-aca5-7b764f3f0430"],

Cell[BoxData[
 RowBox[{"MILoadSolution", "[", "]"}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"5362f5b1-77e4-448b-af51-2584ade9375d"],

Cell["\<\
We can include a view of the solution's field lines in the worksheet\
\>", "Text",ExpressionUUID->"6d969e2e-d149-4664-a1aa-35fd59d36777"],

