Cell[TextData[{
 "Or we could, for example, plot the results along a line using ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "'s built-in plotting routines:"
}], "Text",ExpressionUUID->"b847b8ad-7cac-4da0-8715-7b88f0ec4210"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"NumberQ", "[", "z", "]"}], ",", 
     RowBox[{
      RowBox[{"MOGetB", "[", 
       RowBox[{"0", ",", "z"}], "]"}], "\[LeftDoubleBracket]", "2", 
      "\[RightDoubleBracket]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", ",", 
     RowBox[{"-", "100"}], ",", "100"}], "}"}], ",", 
   RowBox[{"PlotPoints", "\[Rule]", "10"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.794001623606504*^9, 3.7940016325093956`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"a10c471b-81da-4d3f-ae95-238a77b4806c"],

