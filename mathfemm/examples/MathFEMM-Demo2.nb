Cell["\<\
Another command associates this BH curve with the Iron material:\
\>", "Text",ExpressionUUID->"9b5e05d8-8425-4f4a-a0ad-6d3d50c6e07a"],

Cell[BoxData[
 RowBox[{"MIAddBHPoints", "[", 
  RowBox[{"\"\<Iron\>\"", ",", "bhcurve"}], "]"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"c48dd491-e75d-4b84-9669-ccb8481204f0"],

Cell["\<\
Add a \"circuit property\" so that we can calculate the properties of the \
coil as seen from the terminals.\
\>", "Text",ExpressionUUID->"1a5f6da9-0d5d-4245-86b9-12e76a3b6303"],

Cell[BoxData[
 RowBox[{"MIAddCircProp", "[", 
  RowBox[{"\"\<icoil\>\"", ",", "20", ",", "1"}], "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"acf2ea50-ef4a-4117-b3b8-c3d0868dd5aa"],

Cell["Apply the materials to the appropriate block labels", "Text",ExpressionUUID->"10072e93-6491-4fb7-8bca-fc6225d54eb2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MISelectLabel", "[", 
   RowBox[{"5", ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MISetBlockProp", "[", 
   RowBox[{
   "\"\<Iron\>\"", ",", "0", ",", "1", ",", "\"\<<None>\>\"", ",", "0", ",", 
    "0", ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MIClearSelected", "[", "]"}], ";"}]}], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"1c33dfa6-2655-41e5-8f0b-bfff43e2b2d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MISelectLabel", "[", 
   RowBox[{"75", ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MISetBlockProp", "[", 
   RowBox[{
   "\"\<Coil\>\"", ",", "0", ",", "1", ",", "\"\<icoil\>\"", ",", "0", ",", 
    "0", ",", "200"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MIClearSelected", "[", "]"}], ";"}]}], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"a56be55d-9671-4514-beca-c7608ee07bea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"MISelectLabel", "[", 
   RowBox[{"30", ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MISetBlockProp", "[", 
   RowBox[{
   "\"\<Air\>\"", ",", "0", ",", "1", ",", "\"\<<None>\>\"", ",", "0", ",", 
    "0", ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MIClearSelected", "[", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.65662811755153*^9, 3.656628117707905*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"d59a77da-60fe-46f5-b09a-db869d810f64"],

Cell["Now, the finished input geometry can be displayed.", "Text",ExpressionUUID->"b4cc9eca-2374-4d1c-8b27-98d1103f06af"],

Cell[BoxData[
 RowBox[{"MIZoomNatural", "[", "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"b8c93a24-ddfd-418d-9421-fd1ff8d1e55c"],

